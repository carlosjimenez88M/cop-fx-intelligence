# ============================================================
# cop-fx-intelligence — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # optional fallback

# Model to use (default: claude-sonnet-4-6)
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.1

# ── FX Data ──────────────────────────────────────────────────
# Alpha Vantage free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

FX_BASE_CURRENCY=USD
FX_QUOTE_CURRENCY=COP
FX_LOOKBACK_DAYS=365

# ── News ─────────────────────────────────────────────────────
# NewsAPI.org free tier: https://newsapi.org/register
NEWSAPI_KEY=

NEWS_MAX_ARTICLES=50

# ── Twitter / X ──────────────────────────────────────────────
# Create app at https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ENABLED=false

# ── App behaviour ─────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
REPORT_OUTPUT_DIR=reports
FORECAST_HORIZON_DAYS=7
